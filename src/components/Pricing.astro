<section id="tarifs" class="section tint">
        <div class="container">
          <p class="eyebrow reveal">Tarifs</p>
          <h2 class="reveal">Trois niveaux, un prix clair</h2>
          <p class="section-lead reveal">
            Envoyez-moi votre modèle : je le classe dans l'un des trois niveaux
            et je vous confirme le tarif.
          </p>

          <div class="cards3">
            <article class="price-card reveal" data-level="simple">
              <div class="price-photo" data-photo="simple"></div>
              <span class="badge pink">Simple</span>
              <h3>Modèle simple</h3>
              <p>
                Petits motifs délicats, bracelets, fleurs discrètes, petite
                surface.
              </p>
              <p class="price">
                à partir de <strong id="p-simple">15</strong> €
              </p>
            </article>

            <article class="price-card reveal" data-level="moyen">
              <div class="price-photo" data-photo="moyen"></div>
              <span class="badge orange">Moyen</span>
              <h3>Motifs détaillés</h3>
              <p>
                Dessins plus travaillés sur le dos de la main ou l'avant-bras,
                mélange de fleurs et de dentelle.
              </p>
              <p class="price">
                à partir de <strong id="p-moyen">30</strong> €
              </p>
            </article>

            <article class="price-card featured reveal" data-level="difficile">
              <span class="ribbon">Le plus demandé</span>
              <div class="price-photo" data-photo="difficile"></div>
              <span class="badge crimson">Difficile</span>
              <h3>Mariée & grand motif</h3>
              <p>
                Motifs très détaillés, mains et bras complets, style mariée ou
                soirée.
              </p>
              <p class="price">
                à partir de <strong id="p-difficile">60</strong> €
              </p>
            </article>
          </div>

          <p class="notice reveal">
            Les prix sont affichés « à partir de ». Le tarif final peut varier
            une fois votre modèle définitif envoyé, après discussion sur
            WhatsApp.
          </p>
        </div>
      </section>
