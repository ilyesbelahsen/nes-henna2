<fieldset class="people-choice">
  <legend>3 · Nombre de personnes</legend>
  <label class="field" for="participants">
    Nombre de personnes
    <input
      id="participants"
      name="participants"
      type="text"
      inputmode="numeric"
      pattern="[0-9]*"
      autocomplete="off"
      value="1"
      required
    />
  </label>
  <p id="participants-help" class="fine">
    Indiquez le nombre de personnes qui viendront au rendez-vous.
  </p>
  <p id="models-requirement" class="models-requirement" role="alert"></p>
</fieldset>
