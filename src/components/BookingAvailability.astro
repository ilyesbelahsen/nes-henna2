<fieldset id="availability" hidden>
  <legend>5 · Disponibilités</legend>
  <div
    class="days"
    id="days"
    hidden
    role="listbox"
    aria-label="Choisir un jour"
  ></div>
  <div
    class="slots"
    id="slots"
    hidden
    role="listbox"
    aria-label="Choisir un horaire"
  ></div>
  <p class="place" id="place-info" aria-live="polite">
    Complétez les étapes précédentes pour voir les jours disponibles.
  </p>
  <p class="fine">
    L'adresse exacte est communiquée uniquement après validation du rendez-vous.
  </p>
</fieldset>
