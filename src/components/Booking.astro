---
import BookingAvailability from "./BookingAvailability.astro";
import BookingContact from "./BookingContact.astro";
import BookingModels from "./BookingModels.astro";
import BookingParticipants from "./BookingParticipants.astro";
---

<section id="reserver" class="section tint">
        <div class="container narrow">
          <p class="eyebrow reveal">Réservation</p>
          <h2 class="reveal">Réservez votre créneau</h2>
          <p class="section-lead reveal">
            Choisissez un créneau disponible et envoyez votre demande. Je vous recontacterai pour la confirmer.
          </p>

          <form id="booking" class="booking reveal" novalidate>
            <label class="booking-trap" aria-hidden="true"
              >Ne pas remplir<input
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
            /></label>
            <BookingContact />
            <BookingParticipants />
            <BookingModels />
            <BookingAvailability />

            <label class="field comment-choice"
              >Commentaire <span class="opt">(facultatif)</span
              ><textarea
                name="commentaire"
                rows="3"
                maxlength="2000"
                placeholder="Occasion, tenue, couleur de la peau, allergies…"
              ></textarea>
            </label>

            <label class="check"
              ><input type="checkbox" name="tarif" required />
              <span
                >J'ai compris que le tarif final est confirmé après envoi du
                modèle définitif.</span
              ></label
            >
            <label class="check"
              ><input type="checkbox" name="annulation" required />
              <span
                >J'ai lu les{" "}
                <a href="#" data-modal="cgv">conditions d'annulation</a>.</span
              ></label
            >

            <p class="error" id="form-error" role="alert" aria-live="polite" hidden></p>
            <button
              class="btn btn-primary btn-lg btn-block"
              id="booking-submit"
              type="submit"
            >
              Envoyer ma demande
            </button>
          </form>
          <div
            id="booking-confirmation"
            class="booking booking-confirmation"
            role="status"
            aria-live="polite"
            tabindex="-1"
            hidden
          ></div>
        </div>
      </section>
