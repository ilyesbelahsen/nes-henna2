---
import "../styles/global.css";
import { SITE_CONFIG } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nes Henna | Henné naturel sur mesure à Paris, Perpignan et Toulouse",
  description = "Nes Henna réalise des tatouages au henné naturel sur mesure pour mariages, fêtes et événements à Paris, Perpignan et Toulouse. Découvrez les modèles et réservez en ligne.",
} = Astro.props;
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, "/")
  .replace(/\.html$/, "")
  .replace(/(.+)\/$/, "$1");
const canonical = new URL(cleanPath, Astro.site ?? Astro.url);
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const logoUrl = new URL(`${baseUrl}assets/logo.png`, Astro.site);
const ogImageUrl = new URL(`${baseUrl}assets/og-image.jpg`, Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${canonical.origin}/#organization`,
      name: "Nes Henna",
      url: canonical.origin,
      logo: logoUrl.href,
      sameAs: [SITE_CONFIG.instagram, SITE_CONFIG.tiktok],
      areaServed: SITE_CONFIG.villes.map((city) => ({
        "@type": "City",
        name: city,
      })),
    },
    {
      "@type": "WebSite",
      "@id": `${canonical.origin}/#website`,
      name: "Nes Henna",
      url: canonical.origin,
      inLanguage: "fr-FR",
      publisher: { "@id": `${canonical.origin}/#organization` },
    },
    {
      "@type": "Service",
      "@id": `${canonical.href}#service`,
      name: "Tatouage au henné naturel sur mesure",
      serviceType: "Application de henné naturel",
      description,
      url: canonical.href,
      provider: { "@id": `${canonical.origin}/#organization` },
      areaServed: SITE_CONFIG.villes.map((city) => ({
        "@type": "City",
        name: city,
      })),
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "EUR",
        lowPrice: Math.min(...Object.values(SITE_CONFIG.prix)),
        offerCount: Object.keys(SITE_CONFIG.prix).length,
        availability: "https://schema.org/InStock",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        [
          "Combien de temps tient le henné ?",
          "En général de 1 à 3 semaines selon la peau, l'endroit du corps et l'entretien.",
        ],
        [
          "Combien de temps dois-je laisser sécher ?",
          "Laissez la pâte sécher au minimum 4 à 5 heures, idéalement toute la nuit.",
        ],
        [
          "Comment entretenir mon henné ?",
          "Grattez doucement la pâte sèche avec de l'huile, évitez l'eau pendant 24 heures puis appliquez une huile douce pour protéger le motif.",
        ],
        [
          "Le henné est-il sans danger ?",
          "Le henné naturel est sans danger. Nes Henna n'utilise jamais de henné noir contenant du PPD.",
        ],
        [
          "Peut-on se faire poser du henné enceinte ?",
          "Le henné naturel est généralement bien toléré, mais demandez l'avis de votre médecin ou sage-femme avant la séance.",
        ],
        [
          "Vous déplacez-vous ?",
          "Oui, contactez Nes Henna sur WhatsApp pour un devis personnalisé selon la zone et le nombre de personnes.",
        ],
        [
          "Que faire si je dois annuler ?",
          "Prévenez Nes Henna au plus tôt sur WhatsApp, au moins 24 heures à l'avance.",
        ],
      ].map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="fr" data-photos="blurred">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <script is:inline>
      try {
        const choice = localStorage.getItem("nas-photos-choice");
        if (choice === "visible" || choice === "blurred") {
          document.documentElement.dataset.photos = choice;
          document.documentElement.dataset.photosChoice = choice;
        }
      } catch (error) {
        document.documentElement.dataset.photosStorage = "unavailable";
        console.warn("Impossible de lire le choix d’affichage des photos.", error);
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nes Henna" />
    <meta name="theme-color" content="#D73463" />
    <meta name="robots" content="index, follow" />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Nes Henna" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nes Henna, henné naturel sur mesure" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Nes Henna, henné naturel sur mesure" />
    <link rel="icon" href={`${baseUrl}assets/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Fredoka:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
    <noscript>
      <p class="photo-gate-noscript">
        Les photos restent floutées lorsque JavaScript est désactivé.
      </p>
    </noscript>
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
