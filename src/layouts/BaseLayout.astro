---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nes Henna – Prestation de henné · Réservez votre rendez-vous",
  description = "Nes Henna, hennaya : henné naturel pour mariages, fêtes et envies du quotidien. Découvrez les réalisations, les tarifs et réservez votre créneau en ligne.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const logoUrl = new URL(`${baseUrl}assets/logo.png`, Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Prestation de henné Nes Henna",
  serviceType: "Application de henné naturel",
  description,
  url: canonical.href,
  provider: {
    "@type": "Organization",
    name: "Nes Henna",
    logo: logoUrl.href,
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#D73463" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={logoUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${baseUrl}assets/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bangers&family=Fredoka:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
