# Copier en .env et renseigner les valeurs. Ne jamais publier ce fichier.

# Google Calendar (compte de service)
GOOGLE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
# Coller la cle privee JSON sur une ligne, en remplaçant les retours a la ligne par \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nremplacer\n-----END PRIVATE KEY-----\n"
AVAILABILITY_CALENDAR_ID=availability-calendar-id
CALENDAR_ID=booking-calendar-id

# Reservations
TIMEZONE=Europe/Paris
SLOT_MINUTES=60
MIN_NOTICE_HOURS=2
MAX_DAYS_AHEAD=60

# Origines du site autorisees, separees par des virgules, sans slash final
ALLOWED_ORIGIN=http://localhost:4321

# SMTP (optionnel : les reservations sont enregistrees sans envoi d'e-mail)
OWNER_EMAIL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

PORT=3000
