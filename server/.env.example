# Copier en .env et renseigner les valeurs. Ne jamais publier ce fichier.

# Google Calendar (compte de service)
GOOGLE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
# Coller la cle privee JSON sur une ligne, en remplaçant les retours a la ligne par \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nremplacer\n-----END PRIVATE KEY-----\n"
TOULOUSE_AVAILABILITY_CALENDAR_ID=toulouse-availability-calendar-id
PARIS_AVAILABILITY_CALENDAR_ID=paris-availability-calendar-id
PERPIGNAN_AVAILABILITY_CALENDAR_ID=perpignan-availability-calendar-id
CALENDAR_ID=booking-calendar-id

# Reservations
TIMEZONE=Europe/Paris
SLOT_MINUTES=60
MIN_NOTICE_HOURS=2
MAX_DAYS_AHEAD=60

# Origines du site autorisees, separees par des virgules, sans slash final
ALLOWED_ORIGIN=http://localhost:4321

# Resend : test sans domaine avec les adresses de test reservees.
# Remplacer par une cle API et un expediteur de domaine verifie en production.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
OWNER_EMAIL=delivered@resend.dev

PORT=3000
